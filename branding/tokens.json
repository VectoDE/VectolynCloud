  "font": {
    "family": {
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible Next",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ]
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Pixelify Sans",
          "monospace"
        ],
        "$description": "Brand typeface: wordmark, headlines, banners, page headings. Weight 700. Outlined to paths in artwork."
      }
    },
    "weight": {
      "regular": 400,
      "bold": 700,
      "heavy": 800
    },
    "scale": {
      "$description": "Major third (1.25) from 16 px; line height for text roles",
      "xs": {
        "size": "12px",
        "line": "16px"
      },
      "sm": {
        "size": "14px",
        "line": "20px"
      },
      "md": {
        "size": "16px",
        "line": "26px"
      },
      "lg": {
        "size": "20px",
        "line": "30px"
      },
      "xl": {
        "size": "25px",
        "line": "32px"
      },
      "2xl": {
        "size": "31px",
        "line": "38px"
      },
      "3xl": {
        "size": "39px",
        "line": "44px"
      },
      "4xl": {
        "size": "49px",
        "line": "54px"
      },
      "5xl": {
        "size": "61px",
        "line": "64px"
      },
      "display": {
        "size": "76px",
        "line": "76px"
      }
    },
    "display-scale": {
      "$description": "Pixelify Sans sizes where one font pixel (0.09143 em) lands on whole screen pixels",
      "d1": {
        "size": "22px",
        "pixel": "2px"
      },
      "d2": {
        "size": "33px",
        "pixel": "3px"
      },
      "d3": {
        "size": "44px",
        "pixel": "4px"
      },
      "d4": {
        "size": "66px",
        "pixel": "6px"
      },
      "d5": {
        "size": "88px",
        "pixel": "8px"
      }
    },
    "tracking": {
      "display": "-0.0286em",
      "display-small": "0",
      "text": "0",
      "$description": "display: letter gap of exactly one font pixel, from 33 px up; below that the font's own spacing"
    }
  },
  "space": {
    "$description": "4 px base; the mark's grid unit scales with it",
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "128px"
  },
  "radius": {
    "$description": "Square everywhere. The brand is built from blocks.",
    "none": "0px"
  },
  "border": {
    "width": {
      "hairline": "1px",
      "strong": "2px"
    }
  },
  "elevation": {
    "$description": "Hard pixel offsets instead of soft blur, like a block's shadow",
    "0": "none",
    "1": "4px 4px 0 #0B0913",
    "2": "8px 8px 0 #0B0913",
    "glow": "0 0 0 1px rgba(0,229,255,.35), 0 0 32px rgba(0,229,255,.18)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "exit": "cubic-bezier(.4,0,1,1)"
    },
    "reduced-motion": "Disable non-essential motion; show the still render instead of the turntable"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "mark": {
    "grid": "8 x 8 units; arms 2 units wide stepping in 1 per row, tip 2 units (rows 0-4), 1 unit gap, gold block 2 x 2 at rows 6-7 under the tip",
    "construction": {
      "use": "every size, one mark: favicon 16 px to key art",
      "rendering": "crisp edges, sizes in multiples of 8 px, no resampling"
    },
    "clearspace": "2 units (the size of the gold block) on every side",
    "lockup-initial": "mark replaces the V: [mark]ECTOLYN; cap height = V body (5 units), top and baseline aligned, gap to E one font pixel (as between letters); never [mark] followed by VECTOLYN",
    "lockup-symbol": "mark stands alone, 4 units clear space (two gold blocks), then the full name centered on the mark",
    "text-only": "no mark available (plain text, chat, MOTD without glyph, console, docs): full name VECTOLYN / VECTOLYN.NET / VectolynCloud",
    "clear-space": "2 units (one gold block) on every side"
  },
  "minecraft": {
    "server-icon": "64 x 64 PNG",
    "motd-centering": "area 270 px, space 4 px, bold +1 px",
    "legacy-fallback": {
      "primary": "§b",
      "accent": "§6"
    },
    "bedrock": {
      "primary": "§b",
      "accent": "§p"
    }
  }
}
