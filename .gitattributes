# Normalise text files to LF in the repository.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts need LF.
*.sh text eol=lf
gradlew text eol=lf

# Binary files.
*.jar binary
*.class binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
