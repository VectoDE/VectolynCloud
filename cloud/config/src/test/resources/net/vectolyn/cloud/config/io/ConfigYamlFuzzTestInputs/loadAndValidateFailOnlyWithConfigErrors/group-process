1schema-version: 1
template: Lobby-Server
software: paper
minecraft-version: "26.3"
java: auto
heap:
  min: 256M
  max: 768M
combat: modern
catalog:
  - id: luckperms
    kind: transitional
  - id: vectolyn-paper
    kind: plugin
process:
  jvm-flags:
    - -XX:+UseG1GC
    - ~
  stop-command: stop
  stop-timeout: 45s
  restart:
    on-crash: true
    max-attempts: 5
    backoff: 5s
    max-backoff: 5m
