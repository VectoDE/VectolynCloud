{
  "name": "vectolyn-panel-web",
  "private": true,
  "version": "0.0.0",
  "description": "Frontend of the VectolynCloud web panel: Next.js, statically exported and embedded in the cloud jar.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "dev": "npm run sync-brand && next dev",
    "build": "npm run sync-brand && next build",
    "typecheck": "tsc --noEmit",
    "check-i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
