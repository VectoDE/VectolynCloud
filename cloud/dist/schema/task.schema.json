{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://github.com/VectoDE/VectolynCloud/raw/main/cloud/dist/schema/task.schema.json",
  "title" : "VectolynCloud tasks/<name>.yml",
  "description" : "Generated from the configuration model of VectolynCloud. Reference: https://github.com/VectoDE/VectolynCloud/blob/main/docs/cloud/config.md",
  "type" : "object",
  "properties" : {
    "schema-version" : {
      "type" : "integer",
      "minimum" : 1,
      "maximum" : 2,
      "description" : "Version of the file format; 2 is current."
    },
    "group" : {
      "type" : "string"
    },
    "scaling" : {
      "$ref" : "#/$defs/ScalingConfig"
    },
    "nodes" : {
      "type" : "array",
      "items" : {
        "type" : "string"
      }
    }
  },
  "required" : [ "schema-version" ],
  "additionalProperties" : false,
  "$defs" : {
    "ScaleUpTriggers" : {
      "type" : "object",
      "properties" : {
        "cpu-above" : {
          "type" : "integer"
        },
        "tps-below" : {
          "type" : "integer"
        },
        "ram-above" : {
          "type" : "integer"
        }
      },
      "additionalProperties" : false
    },
    "ScalingConfig" : {
      "type" : "object",
      "properties" : {
        "static-services" : {
          "type" : "integer"
        },
        "min-services" : {
          "type" : "integer"
        },
        "max-services" : {
          "type" : "integer"
        },
        "players-per-service" : {
          "type" : "integer"
        },
        "scale-up-at" : {
          "type" : "integer"
        },
        "scale-down-below" : {
          "type" : "integer"
        },
        "scale-down-after" : {
          "type" : "string",
          "pattern" : "^(0|[1-9][0-9]{0,5})[smh]$",
          "description" : "<number>s, <number>m or <number>h, for example 30s"
        },
        "cooldown" : {
          "type" : "string",
          "pattern" : "^(0|[1-9][0-9]{0,5})[smh]$",
          "description" : "<number>s, <number>m or <number>h, for example 30s"
        },
        "scale-up-on" : {
          "$ref" : "#/$defs/ScaleUpTriggers"
        },
        "schedules" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/ScalingSchedule"
          }
        }
      },
      "required" : [ "static-services" ],
      "additionalProperties" : false
    },
    "ScalingSchedule" : {
      "type" : "object",
      "properties" : {
        "days" : {
          "type" : "array",
          "items" : {
            "type" : "string",
            "enum" : [ "mon", "tue", "wed", "thu", "fri", "sat", "sun" ]
          }
        },
        "from" : {
          "type" : "string",
          "pattern" : "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description" : "HH:mm with 24 hours, for example 18:30"
        },
        "to" : {
          "type" : "string",
          "pattern" : "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description" : "HH:mm with 24 hours, for example 18:30"
        },
        "min-services" : {
          "type" : "integer"
        }
      },
      "required" : [ "days", "from", "to", "min-services" ],
      "additionalProperties" : false
    }
  }
}
