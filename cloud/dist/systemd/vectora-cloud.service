# systemd unit for VectoraCloud on Linux (VPS, dedicated server).
#
# Install (as root, once):
#   useradd --system --user-group --home-dir /opt/vectora --create-home --shell /usr/sbin/nologin vectora
#   install -o vectora -g vectora -m 0644 VectoraCloud.jar /opt/vectora/VectoraCloud.jar
#   install -o vectora -g vectora -m 0755 start.sh /opt/vectora/start.sh
#   install -o root -g root -m 0644 vectora-cloud.service /etc/systemd/system/vectora-cloud.service
#   systemctl daemon-reload
#   systemctl enable --now vectora-cloud
#
# The first start needs answers for the setup assistant. Either run the questions once by hand as
# the vectora user (sudo -u vectora /opt/vectora/start.sh, then "shutdown") before enabling the
# unit, or write /opt/vectora/setup.yml (see docs/cloud/setup.md) and switch to the ExecStart line
# with --setup-file in a drop-in. Details: docs/cloud/operations.md.
#
# Change settings with "systemctl edit vectora-cloud" (a drop-in), not in this file.

[Unit]
Description=VectoraCloud (Minecraft network cloud)
Documentation=https://github.com/VectoDE/VectoraCloud/blob/main/docs/cloud/operations.md
Wants=network-online.target
After=network-online.target
# An external MariaDB on the same host should be up first; harmless if there is none.
After=mariadb.service mysql.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=vectora
Group=vectora
WorkingDirectory=/opt/vectora
Environment=VECTORA_HOME=/opt/vectora
Environment=VECTORA_XMX=512M
# Optional: a fixed Java instead of the one on the PATH.
#Environment=JAVA_HOME=/usr/lib/jvm/temurin-25-jre-amd64
ExecStart=/opt/vectora/start.sh --non-interactive
# With a setup file for the first start (ignored once the setup is complete):
#ExecStart=
#ExecStart=/opt/vectora/start.sh --non-interactive --setup-file /opt/vectora/setup.yml

# The cloud reads commands from stdin; under systemd stdin is empty and the cloud keeps running.
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vectora-cloud

# Stop: SIGTERM goes to the cloud only (KillMode=mixed). The cloud then sends every server its
# stop command and waits for it (process.stop-timeout, 60 s by default), stops the managed
# database last and exits. Only what is still running after TimeoutStopSec gets SIGKILL.
# With control-group (the default) every server would get SIGTERM at the same moment instead.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5min
# A JVM ends with 143 after SIGTERM; that is a clean stop, not a failure.
SuccessExitStatus=143

# Restart after a crash, but not for mistakes a restart cannot fix:
# 2 root refused, 3 Java missing or too old, 4 broken embedded library, 5 no node entry point,
# 64 invalid argument, 66 VectoraCloud.jar or home missing (see docs/cloud/operations.md).
Restart=on-failure
RestartSec=15s
RestartPreventExitStatus=2 3 4 5 64 66

# Limits. Every Minecraft server is a JVM with many threads; each thread counts as a task.
LimitNOFILE=65536
TasksMax=8192

# Hardening. The cloud and its servers may write only to their home (and their private /tmp).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/vectora
ProtectHome=yes
# The managed MariaDB puts its socket into the temp directory. PrivateTmp gives the whole unit
# (cloud, servers, MariaDB) one private /tmp, so the socket still works between them. The
# servers connect over TCP on 127.0.0.1 anyway.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The cloud reads /proc/<pid> of its own servers (orphan check); invisible hides only other users.
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# MariaDB (managed mode) uses io_uring where the kernel offers it; it is not in @system-service.
SystemCallFilter=io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Not set on purpose: MemoryDenyWriteExecute=yes breaks the JIT compiler of the JVM.

[Install]
WantedBy=multi-user.target
