# Copy to vectora.env and fill in. vectora.env is gitignored and must never be committed.
# VectoraCloud generates these values on first start (stage 2). See templates/placeholders.md.

# Velocity modern-forwarding secret, 32+ random characters, same on proxy and all backends
VECTORA_FORWARDING_SECRET=

# Forwarding secret of the legacy proxy (bungeeguard token for the 1.8.8 servers), 32+ random
# characters. Never the same as VECTORA_FORWARDING_SECRET: the legacy proxy sends it in plain text
VECTORA_LEGACY_FORWARDING_SECRET=

# Password of the LuckPerms database user
VECTORA_DB_PASSWORD=

# Password of the MariaDB root user. Administration and cloud setup only: the managed mode sets it
# on the first start, the docker mode hands it to the container. Not used in any server template
VECTORA_DB_ROOT_PASSWORD=

# management-server-secret for server.properties, 40 alphanumeric characters
VECTORA_MANAGEMENT_SECRET=

# Floodgate AES key (16 bytes), base64 encoded; written to every key.pem
VECTORA_FLOODGATE_KEY_B64=

# MariaDB connection. VECTORA_DB_STORAGE_METHOD and VECTORA_DB_POOL_SIZE are not set here: the cloud
# derives them from the database mode and from the number of services (see templates/placeholders.md)
VECTORA_DB_HOST=
VECTORA_DB_PORT=
VECTORA_DB_NAME=
VECTORA_DB_USER=
