# --- Local backups -----------------------------------------------------------
.local-backup/

# --- Server runtime (worlds, jars, logs, real secrets) -------------------------
# Only templates/<Server>/ is tracked. runtime/ folders, secrets and everything else the cloud
# writes belong in the cloud home outside the repository.
# Checkouts from before the layout change may still hold a Server-Network/ folder with runtime
# data and secrets; it stays ignored as a whole so none of it can be committed by accident.
Server-Network/
# Runtime folders of a cloud home that was put inside the checkout by mistake.
**/runtime/
**/runtime-*/

# --- Secrets -------------------------------------------------------------------
**/secrets/*
!**/secrets/*.example
.env
.env.*
!.env.example
# Docker Compose (cloud/dist/docker): password files and the filled-in setup file.
cloud/dist/docker/secrets/
cloud/dist/docker/setup.yml
*.secret
key.pem
*.key
*.p12
*.jks

# --- Gradle --------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/

# --- Fuzzing (Jazzer) -----------------------------------------------------------
# Generated corpus of local or nightly fuzz runs. Crashing inputs that should be replayed as
# regression tests are committed under src/test/resources/<package>/<Class>Inputs/<method>/.
.cifuzz-corpus/

# --- Java and other binaries -----------------------------------------------------
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.class
*.zip
hs_err_pid*.log
replay_pid*.log

# --- Logs ------------------------------------------------------------------------
logs/
*.log
*.log.gz

# --- IDEs ------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.settings/
.project
.classpath
.factorypath
bin/
*.swp
*~

# --- OS files --------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Local worktrees -----------------------------------------------------------------
.claude/worktrees/
