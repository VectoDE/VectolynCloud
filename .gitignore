# --- Local backups -----------------------------------------------------------
.local-backup/

# --- Local cloud home ------------------------------------------------------------
# ./gradlew :cloud:node:runLocal starts the built VectoraCloud.jar with run/ as its cloud home.
# Everything in it (configuration, secrets, worlds, logs, downloaded software) stays local.
/run/

# --- Server runtime (worlds, jars, logs, real secrets) -------------------------
# Only templates/<Server>/ is tracked. Everything the cloud writes belongs in run/ or in a cloud
# home outside the repository.
# Checkouts from before the layout change may still hold a Server-Network/ folder with runtime
# data and secrets; it stays ignored as a whole so none of it can be committed by accident.
Server-Network/
# Runtime folders of a cloud home that was put inside the checkout by mistake.
**/runtime/
**/runtime-*/
# A cloud home started directly in the repository root (working directory = checkout) instead of
# run/; these root-anchored entries only keep its files out of commits. Current layout: config/,
# local/, temp/, database/, storage/, secrets/, backups/, logs/, state/. The entries further down
# belong to the older layout (cloud.yml, groups/, cache/, jre/, Database/, ...) and stay for
# checkouts that still have them.
/config/
/local/
/temp/
/database/
/storage/
/state/
/logs/
/backups/
/cloud.yml
/nodes.yml
/software.lock.yml
/backup.yml
/monitor.yml
/groups/
/tasks/
/cache/
/jre/
/Proxy/
/Legacy-Proxy/
/Lobby-Server/
/Survival-Server/
/Creative-Server/
/Mod-Server/
/End-Server/
/Minigame-Server/
/Legacy-Server/
/Database/

# --- Secrets -------------------------------------------------------------------
**/secrets/*
!**/secrets/*.example
.env
.env.*
!.env.example
# Docker Compose (cloud/dist/docker): password files and the filled-in setup file.
cloud/dist/docker/secrets/
cloud/dist/docker/setup.yml
*.secret
key.pem
*.key
*.p12
*.jks

# --- Gradle --------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/

# --- Fuzzing (Jazzer) -----------------------------------------------------------
# Generated corpus of local or nightly fuzz runs. Crashing inputs that should be replayed as
# regression tests are committed under src/test/resources/<package>/<Class>Inputs/<method>/.
.cifuzz-corpus/

# --- Java and other binaries -----------------------------------------------------
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.class
*.zip
hs_err_pid*.log
replay_pid*.log

# --- Logs ------------------------------------------------------------------------
logs/
*.log
*.log.gz

# --- IDEs ------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.settings/
.project
.classpath
.factorypath
bin/
*.swp
*~

# --- OS files --------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Local worktrees -----------------------------------------------------------------
.claude/worktrees/
