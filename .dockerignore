# Build context of VectoraCloud/dist/docker/Dockerfile (the repository root).
# The image build needs the Gradle project and the start script, nothing else.

# Never send secrets, server runtimes or local state to the Docker daemon.
**/secrets/
**/*.env
!**/*.env.example
Server-Network/
**/runtime/
**/runtime-*/

# Version control, IDE and agent folders.
.git/
.github/
.claude/
.idea/
.vscode/
*.iml

# Build output and caches; the image builds everything itself.
**/build/
**/.gradle/
**/out/
**/bin/
**/*.log
**/hs_err_pid*

# Documentation is not part of the image.
docs/
*.md
!VectoraCloud/**/src/**/*.md

# The node carries the server templates in VectoraCloud.jar (docs/cloud/node.md#built-in-templates),
# so the templates, and only they, come back in. secrets/ and runtime/ stay out (rules above).
!Server-Network/*/template/
!Server-Network/*/template/**
